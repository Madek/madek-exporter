#!/usr/bin/env bash
# Ensure libs for Electron packaging/smoke.
# Prefer passwordless sudo apt when available; otherwise extract .debs into .tools/sysroot
# (Cider executors often have sudo but require a password / TTY).
set -euo pipefail

export DEBIAN_FRONTEND=noninteractive

ROOT_DIR="$(cd -- "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
cd "$ROOT_DIR"

SYSROOT="${ROOT_DIR}/.tools/sysroot"
APT_CACHE="${ROOT_DIR}/.tools/apt-cache"
ENV_FILE="${ROOT_DIR}/.tools/sysroot-env.sh"

pkg_installed() {
  dpkg -s "$1" >/dev/null 2>&1
}

pkg_available() {
  apt-cache show "$1" >/dev/null 2>&1
}

have_passwordless_sudo() {
  command -v sudo >/dev/null 2>&1 && sudo -n true >/dev/null 2>&1
}

write_env_file() {
  mkdir -p "$(dirname "$ENV_FILE")"
  local libdirs=()
  local d
  for d in \
    "${SYSROOT}/usr/lib/x86_64-linux-gnu" \
    "${SYSROOT}/lib/x86_64-linux-gnu" \
    "${SYSROOT}/usr/lib" \
    "${SYSROOT}/lib"
  do
    [[ -d "$d" ]] && libdirs+=("$d")
  done

  {
    echo "# Generated by bin/install-missing-libs — source before smoke/Electron"
    if [[ "${#libdirs[@]}" -gt 0 ]]; then
      echo "export LD_LIBRARY_PATH=\"$(IFS=:; echo "${libdirs[*]}"):\${LD_LIBRARY_PATH:-}\""
    fi
  } > "$ENV_FILE"
  echo "[install-missing-libs] wrote ${ENV_FILE}"
}

extract_debs() {
  local pkgs=("$@")
  [[ "${#pkgs[@]}" -eq 0 ]] && return 0

  mkdir -p "$APT_CACHE" "$SYSROOT"
  echo "[install-missing-libs] user-space extract: ${pkgs[*]}"

  (
    cd "$APT_CACHE"
    # Refresh index if possible (no root needed for download from configured mirrors)
    apt-get download "${pkgs[@]}" || {
      echo "[install-missing-libs] apt-get download failed; trying apt-get update then download" >&2
      apt-get update -qq || true
      apt-get download "${pkgs[@]}"
    }
  )

  local deb
  for deb in "$APT_CACHE"/*.deb; do
    [[ -f "$deb" ]] || continue
    echo "[install-missing-libs] extracting $(basename "$deb")"
    dpkg-deb -x "$deb" "$SYSROOT"
  done

  write_env_file
}

install_with_sudo() {
  local pkgs=("$@")
  echo "[install-missing-libs] passwordless sudo OK — apt-get install: ${pkgs[*]:-none}"
  sudo -n apt-get update -qq
  if [[ "${#pkgs[@]}" -gt 0 ]]; then
    sudo -n apt-get install -y --no-install-recommends "${pkgs[@]}"
  fi
}

REQUIRED_PKGS=(
  libgtk-3-0
  libnss3
  libxss1
  libasound2
  libgbm1
  libx11-xcb1
  libxcomposite1
  libxdamage1
  libxrandr2
  libatk-bridge2.0-0
  libdrm2
)

MISSING=()
PRESENT=()

for pkg in "${REQUIRED_PKGS[@]}"; do
  if pkg_installed "$pkg"; then
    PRESENT+=("$pkg")
  else
    MISSING+=("$pkg")
  fi
done

# xvfb: command check (package name xvfb)
if command -v xvfb-run >/dev/null 2>&1; then
  PRESENT+=("xvfb-run(cmd)")
else
  MISSING+=("xvfb")
fi

if pkg_installed libgconf-2-4; then
  PRESENT+=("libgconf-2-4")
elif pkg_available libgconf-2-4; then
  MISSING+=("libgconf-2-4")
else
  echo "[install-missing-libs] skip unavailable package: libgconf-2-4"
fi

echo "[install-missing-libs] present: ${PRESENT[*]:-none}"
echo "[install-missing-libs] missing: ${MISSING[*]:-none}"

if [[ "${#MISSING[@]}" -gt 0 ]]; then
  if have_passwordless_sudo; then
    install_with_sudo "${MISSING[@]}"
  else
    echo "[install-missing-libs] no passwordless sudo — extracting .debs into ${SYSROOT}"
    # Only extract real library packages; xvfb can't usefully run from a sysroot without binaries on PATH
    EXTRACT=()
    for pkg in "${MISSING[@]}"; do
      if [[ "$pkg" == "xvfb" ]]; then
        echo "[install-missing-libs] ERROR: xvfb-run missing and cannot install without passwordless sudo" >&2
        exit 1
      fi
      EXTRACT+=("$pkg")
    done
    extract_debs "${EXTRACT[@]}"
  fi
else
  write_env_file
fi

if ! command -v xvfb-run >/dev/null 2>&1; then
  echo "[install-missing-libs] ERROR: xvfb-run still missing" >&2
  exit 1
fi

# Wine: optional for win32 packaging (icon via rcedit). Without passwordless sudo we skip.
if command -v wine >/dev/null 2>&1 || command -v wine64 >/dev/null 2>&1; then
  echo "[install-missing-libs] wine present: $(command -v wine64 || command -v wine)"
elif have_passwordless_sudo; then
  echo "[install-missing-libs] installing wine64 via sudo -n"
  sudo -n dpkg --add-architecture i386 || true
  sudo -n apt-get update -qq
  if ! sudo -n apt-get install -y --no-install-recommends wine64; then
    sudo -n apt-get install -y --no-install-recommends wine || {
      echo "[install-missing-libs] warn: wine install failed; Windows package build may skip icon embedding"
    }
  fi
else
  echo "[install-missing-libs] warn: wine not installed (no passwordless sudo)."
  echo "[install-missing-libs] warn: Windows build will continue; Electron may skip win icon embedding."
fi

echo "[install-missing-libs] done"
