#!/usr/bin/env bash
# Package Electron app for Windows (win32/x64).
# Do not pass Madek.icns here: packager rewrites the extension to .ico and then
# rcedit (via wine) fails on Linux CI with ENOENT on the .exe. Use Madek.ico
# only when present and wine is available.
set -euo pipefail

# shellcheck disable=SC1091
source "$(cd -- "$(dirname "${BASH_SOURCE[0]}")" && pwd)/env/packager-tmpdir.bash"
# shellcheck disable=SC1091
source "$(cd -- "$(dirname "${BASH_SOURCE[0]}")" && pwd)/env/madek-exporter-version.bash"

PACKAGES_DIR="./target/packages"
OUTPUT_DIR="$PACKAGES_DIR/madek-exporter-win32-x64"

mkdir -p "$PACKAGES_DIR"
rm -rf "$OUTPUT_DIR"

ELECTRON_VERSION=$(node -p "require('./package.json').config.electronVersion")

PACKAGER_ARGS=(
  --overwrite
  --platform=win32
  --arch=x64
  --electron-version="$ELECTRON_VERSION"
  --asar
  --out="$PACKAGES_DIR"
)

if [[ -f Madek.ico ]] && { command -v wine >/dev/null 2>&1 || command -v wine64 >/dev/null 2>&1; }; then
  PACKAGER_ARGS+=(--icon=Madek.ico)
  echo "Using Madek.ico (wine available)"
else
  echo "Skipping Windows app icon (need Madek.ico + wine); packaging with default Electron icon"
fi

npx @electron/packager \
  "${PACKAGER_ARGS[@]}" \
  ./app/prod madek-exporter

cp -Lrf vendor/jre_win_x64/. "$OUTPUT_DIR/resources/jre"
cp -Lf app/prod/jvm-main.jar "$OUTPUT_DIR/resources/jvm-main.jar"
cp packaging/README.txt "$OUTPUT_DIR/README.txt"
substitute_madek_exporter_version_in_readme "$OUTPUT_DIR/README.txt"

echo "  ${OUTPUT_DIR}/"
