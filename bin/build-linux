#!/usr/bin/env bash
set -euo pipefail

# shellcheck disable=SC1091
source "$(cd -- "$(dirname "${BASH_SOURCE[0]}")" && pwd)/env/packager-tmpdir.bash"
# shellcheck disable=SC1091
source "$(cd -- "$(dirname "${BASH_SOURCE[0]}")" && pwd)/env/madek-exporter-version.bash"

PACKAGES_DIR="./target/packages"
OUTPUT_DIR="$PACKAGES_DIR/madek-exporter-linux-x64"

mkdir -p "$PACKAGES_DIR"
rm -rf "$OUTPUT_DIR"

ELECTRON_VERSION=$(node -p "require('./package.json').config.electronVersion")

npx @electron/packager \
  --overwrite --platform=linux --arch=x64 --electron-version="$ELECTRON_VERSION" --asar \
  --out="$PACKAGES_DIR" \
  ./app/prod madek-exporter

cp -Lrf vendor/jre_linux_x64/. "$OUTPUT_DIR/resources/jre"
cp -Lf app/prod/jvm-main.jar "$OUTPUT_DIR/resources/jvm-main.jar"
cp packaging/README.txt "$OUTPUT_DIR/README.txt"
substitute_madek_exporter_version_in_readme "$OUTPUT_DIR/README.txt"
