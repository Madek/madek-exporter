#!/usr/bin/env bash
set -euo pipefail

fail() {
  echo "[artifact-check] ERROR: $*" >&2
  exit 1
}

require_file() {
  local p="$1"
  [ -f "$p" ] || fail "missing file: $p"
}

require_exec() {
  local p="$1"
  [ -x "$p" ] || fail "missing executable: $p"
}

require_dir() {
  local p="$1"
  [ -d "$p" ] || fail "missing directory: $p"
}

# Core build artifacts
require_file "app/prod/jvm-main.jar"
require_file "app/prod/css/site.css"

if grep -q "Error: Can't find stylesheet to import" app/prod/css/site.css; then
  fail "stylesheet build contains sass error marker"
fi

# Platform packages: required in Cider-CI; locally best-effort
require_platform_packages() {
  require_dir "target/packages/madek-exporter-darwin-x64/madek-exporter.app/Contents/Resources"
  require_exec "target/packages/madek-exporter-darwin-x64/madek-exporter.app/Contents/Resources/jre/bin/java"

  require_dir "target/packages/madek-exporter-darwin-arm64/madek-exporter.app/Contents/Resources"
  require_exec "target/packages/madek-exporter-darwin-arm64/madek-exporter.app/Contents/Resources/jre/bin/java"

  require_dir "target/packages/madek-exporter-linux-x64/resources"
  require_exec "target/packages/madek-exporter-linux-x64/resources/jre/bin/java"

  require_dir "target/packages/madek-exporter-linux-arm64/resources"
  require_exec "target/packages/madek-exporter-linux-arm64/resources/jre/bin/java"

  require_dir "target/packages/madek-exporter-win32-x64/resources"
  require_file "target/packages/madek-exporter-win32-x64/resources/jre/bin/java.exe"
}

# Prefer system interpreters; asdf/mise shims fail without a pinned python in .tool-versions.
find_python() {
  local c
  for c in \
    /usr/bin/python3 \
    /usr/bin/python3.12 \
    /usr/bin/python3.11 \
    /usr/bin/python3.10 \
    /usr/bin/python3.9 \
    /usr/bin/python3.8 \
    /bin/python3
  do
    if [[ -x "$c" ]]; then
      echo "$c"
      return 0
    fi
  done
  return 1
}

# Electron .app frameworks need Libraries/Current/... as symlinks. Zips that
# follow or drop those links crash on launch (missing @rpath/libffmpeg.dylib).
# Arg1: zip path. Arg2: package root basename inside the zip
# (e.g. madek-exporter-darwin-x64 or madek-exporter-darwin-arm64).
require_mac_zip_preserves_framework_symlinks() {
  local zip="$1"
  local pkg_root="$2"
  local python_bin
  require_file "$zip"
  python_bin="$(find_python)" || fail "no system python3 for Mac zip symlink check"
  "$python_bin" - "$zip" "$pkg_root" <<'PY' || fail "Mac zip missing Electron framework symlinks (libffmpeg): ${zip}"
import stat
import sys
import zipfile

zip_path = sys.argv[1]
pkg_root = sys.argv[2].rstrip("/")
need = {
    f"{pkg_root}/madek-exporter.app/Contents/Frameworks/Electron Framework.framework/Libraries",
    f"{pkg_root}/madek-exporter.app/Contents/Frameworks/Electron Framework.framework/Versions/Current",
}
found = set()
with zipfile.ZipFile(zip_path) as zf:
    for info in zf.infolist():
        name = info.filename.rstrip("/")
        if name not in need:
            continue
        mode = (info.external_attr >> 16) & 0o170000
        if mode == stat.S_IFLNK:
            found.add(name)
missing = sorted(need - found)
if missing:
    print("missing symlink entries:", ", ".join(missing), file=sys.stderr)
    sys.exit(1)
PY
}

if [[ -n "${CIDER_CI_TREE_ID:-}" ]]; then
  require_platform_packages
  require_file "target/dist/Madek-Exporter_Mac-OS-x64.zip"
  require_file "target/dist/Madek-Exporter_Mac-OS-ARM64.zip"
  require_file "target/dist/Madek-Exporter_Linux-x64.zip"
  require_file "target/dist/Madek-Exporter_Linux-ARM64.zip"
  require_file "target/dist/Madek-Exporter_Windows.zip"
  require_mac_zip_preserves_framework_symlinks \
    "target/dist/Madek-Exporter_Mac-OS-x64.zip" "madek-exporter-darwin-x64"
  require_mac_zip_preserves_framework_symlinks \
    "target/dist/Madek-Exporter_Mac-OS-ARM64.zip" "madek-exporter-darwin-arm64"
else
  if [ -d "target/packages/madek-exporter-darwin-x64/madek-exporter.app/Contents/Resources" ]; then
    require_exec "target/packages/madek-exporter-darwin-x64/madek-exporter.app/Contents/Resources/jre/bin/java"
  fi
  if [ -d "target/packages/madek-exporter-darwin-arm64/madek-exporter.app/Contents/Resources" ]; then
    require_exec "target/packages/madek-exporter-darwin-arm64/madek-exporter.app/Contents/Resources/jre/bin/java"
  fi
  if [ -d "target/packages/madek-exporter-linux-x64/resources" ]; then
    require_exec "target/packages/madek-exporter-linux-x64/resources/jre/bin/java"
  fi
  if [ -d "target/packages/madek-exporter-linux-arm64/resources" ]; then
    require_exec "target/packages/madek-exporter-linux-arm64/resources/jre/bin/java"
  fi
  if [ -d "target/packages/madek-exporter-win32-x64/resources" ]; then
    require_file "target/packages/madek-exporter-win32-x64/resources/jre/bin/java.exe"
  fi
  if [ -f "target/dist/Madek-Exporter_Mac-OS-x64.zip" ]; then
    require_mac_zip_preserves_framework_symlinks \
      "target/dist/Madek-Exporter_Mac-OS-x64.zip" "madek-exporter-darwin-x64"
  fi
  if [ -f "target/dist/Madek-Exporter_Mac-OS-ARM64.zip" ]; then
    require_mac_zip_preserves_framework_symlinks \
      "target/dist/Madek-Exporter_Mac-OS-ARM64.zip" "madek-exporter-darwin-arm64"
  fi
fi

echo "[artifact-check] OK"
