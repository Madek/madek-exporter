#!/usr/bin/env bash
set -euo pipefail

# Combined prod cljsbuild for main + front (used by `npm run build:electron:prod`).
# Keep post-compile strip in sync with bin/build-electron-{front,main}-prod and CI.

rm -rf \
  app/prod/js/out_main \
  app/prod/js/out_front \
  app/prod/js/main.js \
  app/prod/js/front.js \
  app/prod/js/main.js.map \
  app/prod/js/front.js.map

lein do \
  externs electron-main-prod app/prod/js/main_externs.js, \
  cljsbuild once electron-main-prod, \
  externs electron-front-prod app/prod/js/front_externs.js, \
  cljsbuild once electron-front-prod

# Advanced build only needs *.js in the package — drop Closure work dirs / maps.
rm -rf \
  app/prod/js/out_main \
  app/prod/js/out_front \
  app/prod/js/main.js.map \
  app/prod/js/front.js.map

./bin/build-stylesheets-prod
